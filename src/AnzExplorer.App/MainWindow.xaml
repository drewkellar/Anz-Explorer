<Window
    x:Class="AnzExplorer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AnzExplorer.App"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Anz Explorer">

    <Grid x:Name="RootLayout" Background="{ThemeResource AnzWindowBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="NavigationButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <Style x:Key="FileRowStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style x:Key="ColumnHeaderButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="BreadcrumbButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="7,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="ColumnResizeThumbStyle" TargetType="primitives:Thumb">
                <!-- Keep the visible divider narrow, but overlap a generous hit
                     target evenly across both adjacent column headers. -->
                <Setter Property="Width" Value="12" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Divider.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Divider.Width" Value="2" />
                                                <Setter Target="Divider.Height" Value="22" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Divider.Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                                <Setter Target="Divider.Width" Value="2" />
                                                <Setter Target="Divider.Height" Value="24" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="Divider"
                                        Width="1"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource AnzColumnDividerBrush}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FileRowEvenStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileRowStyle}">
                <Setter Property="Background" Value="{ThemeResource AnzRowEvenBrush}" />
            </Style>
            <Style x:Key="FileRowOddStyle" TargetType="ListViewItem" BasedOn="{StaticResource FileRowStyle}">
                <Setter Property="Background" Value="{ThemeResource AnzRowOddBrush}" />
            </Style>
            <local:AlternatingRowStyleSelector x:Key="FileRowStyleSelector"
                                               EvenStyle="{StaticResource FileRowEvenStyle}"
                                               OddStyle="{StaticResource FileRowOddStyle}" />
            <local:ColumnLayoutState x:Key="ColumnLayout" />
            <local:DisplayScaleState x:Key="DisplayScale" />
            <local:ScaledDoubleConverter x:Key="ScaledDoubleConverter" />
            <Style x:Key="FileTileItemStyle" TargetType="ListViewItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>
            <ItemsPanelTemplate x:Key="VerticalItemsPanel">
                <ItemsStackPanel Orientation="Vertical" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="WrappingItemsPanel">
                <ItemsWrapGrid Orientation="Horizontal" />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="ListItemsPanel">
                <ItemsWrapGrid Orientation="Vertical" />
            </ItemsPanelTemplate>
            <DataTemplate x:Key="DetailsFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <Grid Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=30}"
                      Width="{Binding ContentWidth, Source={StaticResource ColumnLayout}}"
                      HorizontalAlignment="Left"
                      Padding="10,0"
                      Background="Transparent"
                      AllowDrop="True"
                      DragOver="FileRow_DragOver"
                      Drop="FileRow_Drop">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource ColumnLayout}}" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource ColumnLayout}}" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource ColumnLayout}}" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource ColumnLayout}}" />
                        <ColumnDefinition Width="12" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=18}"
                              Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=18}">
                            <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="1" Visibility="{x:Bind FolderIconVisibility}" />
                            <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=14}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                            <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind ModifiedText}" />
                    <TextBlock Grid.Column="4" Margin="8,0" VerticalAlignment="Center" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="6" Margin="8,0" VerticalAlignment="Center" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind SizeText, Mode=OneWay}" />
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ListFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=230}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=34}" Padding="8,0" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=20}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=20}">
                            <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="1" Visibility="{x:Bind FolderIconVisibility}" />
                            <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=16}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                            <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=185}" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="SmallIconFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=220}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=34}" Padding="8,0" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=18}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=18}">
                            <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="1" Visibility="{x:Bind FolderIconVisibility}" />
                            <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=14}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                            <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=175}" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="MediumIconFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <StackPanel Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=108}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=92}" Padding="6" Spacing="5" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=44}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=44}" HorizontalAlignment="Center">
                        <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="2" Visibility="{x:Bind FolderIconVisibility}" />
                        <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=38}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                        <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" MaxWidth="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=96}" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="LargeIconFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <StackPanel Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=138}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=126}" Padding="8" Spacing="6" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=68}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=68}" HorizontalAlignment="Center">
                        <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="3" Visibility="{x:Bind FolderIconVisibility}" />
                        <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=60}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                        <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" MaxWidth="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=122}" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="ExtraLargeIconFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <StackPanel Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=178}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=164}" Padding="10" Spacing="7" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=100}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=100}" HorizontalAlignment="Center">
                        <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="4" Visibility="{x:Bind FolderIconVisibility}" />
                        <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=90}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                        <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" MaxWidth="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=158}" FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="TileFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=280}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=64}" Padding="10,6" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=48}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=40}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=40}" VerticalAlignment="Center">
                        <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="2" Visibility="{x:Bind FolderIconVisibility}" />
                        <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=34}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                        <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=11}" Opacity="0.7" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="ContentFileItemTemplate" x:DataType="local:FileSystemItemViewModel">
                <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=720}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=72}" Padding="12,7" AllowDrop="True" DragOver="FileRow_DragOver" Drop="FileRow_Drop">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=52}" /><ColumnDefinition Width="*" /><ColumnDefinition Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=140}" /></Grid.ColumnDefinitions>
                    <Grid Width="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=42}" Height="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=42}" VerticalAlignment="Center">
                        <Path Data="M1,3 L7,3 L9,5 L17,5 L17,15 L1,15 Z" Fill="{x:Bind IconBrush}" Stretch="Uniform" Margin="2" Visibility="{x:Bind FolderIconVisibility}" />
                        <FontIcon FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=36}" Glyph="{x:Bind Glyph}" Foreground="{x:Bind IconBrush}" Visibility="{x:Bind GlyphIconVisibility}" />
                        <Image Source="{x:Bind ShellIcon, Mode=OneWay}" Stretch="Uniform" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=12}" FontWeight="SemiBold" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=11}" Opacity="0.72" Text="{x:Bind Type}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=11}" Opacity="0.72" Text="{x:Bind ModifiedText}" />
                        <TextBlock FontSize="{Binding Scale, Source={StaticResource DisplayScale}, Converter={StaticResource ScaledDoubleConverter}, ConverterParameter=11}" Opacity="0.72" Text="{x:Bind SizeText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Background="{ThemeResource AnzPaneBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="Transparent">
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="9">
                    <Image Width="22" Height="22" Source="Assets/AnzExplorer.png" Stretch="Uniform" />
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="Anz Explorer" />
                </StackPanel>
            </Grid>
            <TabView x:Name="Tabs"
                     Grid.Column="1"
                     Margin="0,0,140,0"
                     TabWidthMode="Equal"
                     CanReorderTabs="False"
                     CanDragTabs="False"
                     CanTearOutTabs="False"
                     AllowDropTabs="False"
                     AddTabButtonClick="Tabs_AddTabButtonClick"
                     SizeChanged="Tabs_SizeChanged"
                     SelectionChanged="Tabs_SelectionChanged"
                     TabCloseRequested="Tabs_TabCloseRequested">
                <TabView.TabStripFooter>
                    <Grid x:Name="TitleBarDragRegion"
                          MinWidth="128"
                          Background="Transparent" />
                </TabView.TabStripFooter>
            </TabView>
            <Border x:Name="TabDropTargetIndicator"
                    Grid.Column="1"
                    Margin="0,2,140,1"
                    Background="#142F81F7"
                    BorderBrush="#FF60A5FA"
                    BorderThickness="1"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
        </Grid>

        <NavigationView x:Name="SidebarNavigation"
                        Grid.Row="1"
                        Background="{ThemeResource AnzPaneBackgroundBrush}"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="210"
                        PaneDisplayMode="Left"
                        SelectionFollowsFocus="Disabled"
                        ItemInvoked="SidebarNavigation_ItemInvoked">
            <Grid Background="{ThemeResource AnzWindowBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Padding="10,7"
                      Background="{ThemeResource AnzPaneBackgroundBrush}"
                      ColumnSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource NavigationButtonStyle}" Content="&#xE72B;" Click="Back_Click" ToolTipService.ToolTip="Back (Alt+Left)" />
                    <Button Grid.Column="1" Style="{StaticResource NavigationButtonStyle}" Content="&#xE72A;" Click="Forward_Click" ToolTipService.ToolTip="Forward (Alt+Right)" />
                    <Button x:Name="UpButton"
                            Grid.Column="2"
                            Style="{StaticResource NavigationButtonStyle}"
                            Content="&#xE74A;"
                            AllowDrop="True"
                            DragOver="UpButton_DragOver"
                            DragLeave="UpButton_DragLeave"
                            Drop="UpButton_Drop"
                            Click="Up_Click"
                            ToolTipService.ToolTip="Up (Alt+Up)" />
                    <Border x:Name="AddressBarHost"
                            Grid.Column="3"
                            Height="34"
                            Margin="5,0,0,0"
                            Background="{ThemeResource AnzSurfaceRaisedBrush}"
                            BorderBrush="{ThemeResource AnzBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Tapped="AddressBarHost_Tapped">
                        <Grid>
                            <ScrollViewer x:Name="BreadcrumbScroller"
                                          HorizontalScrollBarVisibility="Hidden"
                                          HorizontalScrollMode="Enabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          VerticalScrollMode="Disabled"
                                          AutomationProperties.Name="Current folder path">
                                <StackPanel x:Name="BreadcrumbPanel"
                                            Padding="3,0"
                                            Orientation="Horizontal" />
                            </ScrollViewer>
                            <TextBox x:Name="AddressBox"
                                     Margin="-1"
                                     Background="{ThemeResource AnzSurfaceRaisedBrush}"
                                     BorderThickness="1"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     KeyDown="AddressBox_KeyDown"
                                     LostFocus="AddressBox_LostFocus"
                                     AutomationProperties.Name="Address" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="4"
                             Height="34"
                             Margin="4,0,0,0"
                             Background="{ThemeResource AnzSurfaceRaisedBrush}"
                             VerticalContentAlignment="Center"
                             PlaceholderText="Search this folder"
                             TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Search" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{ThemeResource AnzSurfaceBrush}"
                        BorderBrush="{ThemeResource AnzBorderBrush}"
                        BorderThickness="0,1,0,1">
                    <CommandBar Background="Transparent"
                                DefaultLabelPosition="Collapsed"
                                IsDynamicOverflowEnabled="True">
                        <AppBarButton x:Name="NewFolderButton" Icon="Add" Label="New" Foreground="{ThemeResource AnzDocumentBrush}" ToolTipService.ToolTip="New item (Ctrl+Shift+N creates a folder)" AutomationProperties.HelpText="New item (Ctrl+Shift+N creates a folder)">
                            <AppBarButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Folder" Click="NewFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AnzFolderBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Shortcut" Click="NewShortcut_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="AutoHotkey Script" Tag="AutoHotkey" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" Foreground="#5DBB63" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Bitmap image" Tag="Bitmap" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource AnzImageBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Python Source File" Tag="Python" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" Foreground="{ThemeResource AnzCodeBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Text Document" Tag="Text" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource AnzDocumentBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarSeparator />
                        <AppBarButton x:Name="CutButton" Icon="Cut" Label="Cut" Click="Cut_Click" ToolTipService.ToolTip="Cut (Ctrl+X)" AutomationProperties.HelpText="Cut (Ctrl+X)" />
                        <AppBarButton x:Name="CopyButton" Icon="Copy" Label="Copy" Click="Copy_Click" ToolTipService.ToolTip="Copy (Ctrl+C)" AutomationProperties.HelpText="Copy (Ctrl+C)" />
                        <AppBarButton x:Name="PasteButton" Icon="Paste" Label="Paste" Foreground="{ThemeResource AnzDownloadBrush}" Click="Paste_Click" ToolTipService.ToolTip="Paste (Ctrl+V)" AutomationProperties.HelpText="Paste (Ctrl+V)" />
                        <AppBarButton x:Name="RenameButton" Icon="Rename" Label="Rename" Click="Rename_Click" ToolTipService.ToolTip="Rename (F2)" AutomationProperties.HelpText="Rename (F2)" />
                        <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Delete" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Click="Delete_Click" ToolTipService.ToolTip="Delete (Delete)" AutomationProperties.HelpText="Delete (Delete)" />
                        <AppBarSeparator />
                        <AppBarButton Icon="Sort" Label="Sort" ToolTipService.ToolTip="Sort items" AutomationProperties.HelpText="Sort items">
                            <AppBarButton.Flyout>
                                <MenuFlyout Opening="SortMenu_Opening">
                                    <ToggleMenuFlyoutItem x:Name="CommandSortNameMenuItem" Text="Name" Tag="Name" Click="BackgroundSortProperty_Click" />
                                    <ToggleMenuFlyoutItem x:Name="CommandSortModifiedMenuItem" Text="Date modified" Tag="Modified" Click="BackgroundSortProperty_Click" />
                                    <ToggleMenuFlyoutItem x:Name="CommandSortTypeMenuItem" Text="Type" Tag="Type" Click="BackgroundSortProperty_Click" />
                                    <ToggleMenuFlyoutItem x:Name="CommandSortSizeMenuItem" Text="Size" Tag="LogicalBytes" Click="BackgroundSortProperty_Click" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem x:Name="CommandSortAscendingMenuItem" Text="Ascending" Tag="Ascending" Click="BackgroundSortDirection_Click" />
                                    <ToggleMenuFlyoutItem x:Name="CommandSortDescendingMenuItem" Text="Descending" Tag="Descending" Click="BackgroundSortDirection_Click" />
                                </MenuFlyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        <AppBarElementContainer>
                            <Button x:Name="ViewCommandButton"
                                    Height="40"
                                    Padding="10,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="4"
                                    AutomationProperties.Name="View"
                                    AutomationProperties.HelpText="Change the file view"
                                    ToolTipService.ToolTip="Change the file view">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon FontSize="16" Glyph="&#xE8FD;" />
                                        <TextBlock VerticalAlignment="Center" Text="View" />
                                        <FontIcon FontSize="9" Glyph="&#xE70D;" />
                                    </StackPanel>
                                </Button.Content>
                                <Button.Flyout>
                                <MenuFlyout Opening="ViewMenu_Opening">
                                    <ToggleMenuFlyoutItem x:Name="ViewExtraLargeMenuItem" Text="Extra large icons" Tag="ExtraLargeIcons" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewLargeMenuItem" Text="Large icons" Tag="LargeIcons" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewMediumMenuItem" Text="Medium icons" Tag="MediumIcons" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewSmallMenuItem" Text="Small icons" Tag="SmallIcons" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewListMenuItem" Text="List" Tag="List" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewDetailsMenuItem" Text="Details" Tag="Details" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewTilesMenuItem" Text="Tiles" Tag="Tiles" Click="ViewMode_Click" />
                                    <ToggleMenuFlyoutItem x:Name="ViewContentMenuItem" Text="Content" Tag="Content" Click="ViewMode_Click" />
                                </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </AppBarElementContainer>
                        <AppBarButton x:Name="ZoomOutButton" Label="Zoom out" Click="ZoomOut_Click" ToolTipService.ToolTip="Zoom out (Ctrl+-)" AutomationProperties.HelpText="Zoom out (Ctrl+-)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE738;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton x:Name="ZoomInButton" Label="Zoom in" Click="ZoomIn_Click" ToolTipService.ToolTip="Zoom in (Ctrl+=)" AutomationProperties.HelpText="Zoom in (Ctrl+=)">
                            <AppBarButton.Icon><FontIcon Glyph="&#xE710;" /></AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Icon="Refresh" Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (F5)" AutomationProperties.HelpText="Refresh (F5)" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton Icon="Setting" Label="Settings" Click="Settings_Click" />
                            <AppBarButton Label="Open in Windows Explorer" Click="OpenInExplorer_Click" />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                </Border>

                <Grid x:Name="FileViewHost" Grid.Row="2" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="BackgroundContextMenuOwner" Visibility="Collapsed">
                    <Border.ContextFlyout>
                        <MenuFlyout x:Name="BackgroundContextFlyout" Opening="BackgroundContextMenu_Opening">
                            <MenuFlyoutSubItem Text="View">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A9;" /></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewExtraLargeMenuItem" Text="Extra large icons" Tag="ExtraLargeIcons" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewLargeMenuItem" Text="Large icons" Tag="LargeIcons" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewMediumMenuItem" Text="Medium icons" Tag="MediumIcons" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewSmallMenuItem" Text="Small icons" Tag="SmallIcons" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewListMenuItem" Text="List" Tag="List" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewDetailsMenuItem" Text="Details" Tag="Details" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewTilesMenuItem" Text="Tiles" Tag="Tiles" Click="ViewMode_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundViewContentMenuItem" Text="Content" Tag="Content" Click="ViewMode_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem Text="Sort by">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8CB;" /></MenuFlyoutSubItem.Icon>
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortNameMenuItem" Text="Name" Tag="Name" Click="BackgroundSortProperty_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortModifiedMenuItem" Text="Date modified" Tag="Modified" Click="BackgroundSortProperty_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortTypeMenuItem" Text="Type" Tag="Type" Click="BackgroundSortProperty_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortSizeMenuItem" Text="Size" Tag="LogicalBytes" Click="BackgroundSortProperty_Click" />
                                <MenuFlyoutSeparator />
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortAscendingMenuItem" Text="Ascending" Tag="Ascending" Click="BackgroundSortDirection_Click" />
                                <ToggleMenuFlyoutItem x:Name="BackgroundSortDescendingMenuItem" Text="Descending" Tag="Descending" Click="BackgroundSortDirection_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="BackgroundNewMenu" Text="New">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="Folder" Click="NewFolder_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="{ThemeResource AnzFolderBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Shortcut" Click="NewShortcut_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71B;" Foreground="{ThemeResource AccentFillColorDefaultBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="AutoHotkey Script" Tag="AutoHotkey" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" Foreground="#5DBB63" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Bitmap image" Tag="Bitmap" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" Foreground="{ThemeResource AnzImageBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Python Source File" Tag="Python" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE943;" Foreground="{ThemeResource AnzCodeBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem Text="Text Document" Tag="Text" Click="NewFile_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource AnzDocumentBrush}" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem x:Name="BackgroundPasteMenuItem" Text="Paste" Click="Paste_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Refresh" Click="Refresh_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="BackgroundOpenTerminalMenuItem" Text="Open in Terminal" Click="BackgroundOpenTerminal_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE756;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="BackgroundPropertiesMenuItem" Text="Properties" Click="BackgroundProperties_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    </Border>

                    <Border x:Name="DetailsHeader"
                            Grid.Row="0"
                            Background="{ThemeResource AnzSurfaceBrush}"
                            BorderBrush="{ThemeResource AnzBorderBrush}"
                            BorderThickness="0,0,0,1"
                            Canvas.ZIndex="2">
                        <Grid Height="30"
                              Width="{Binding ContentWidth, Source={StaticResource ColumnLayout}}"
                              HorizontalAlignment="Left"
                              Padding="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding NameWidth, Source={StaticResource ColumnLayout}}" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="{Binding ModifiedWidth, Source={StaticResource ColumnLayout}}" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="{Binding TypeWidth, Source={StaticResource ColumnLayout}}" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="{Binding SizeWidth, Source={StaticResource ColumnLayout}}" />
                                <ColumnDefinition Width="12" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Tag="Name" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Name" /><TextBlock x:Name="NameSortIndicator" /></StackPanel>
                            </Button>
                            <primitives:Thumb Grid.Column="1" Tag="Name" Style="{StaticResource ColumnResizeThumbStyle}" DragDelta="ColumnSplitter_DragDelta" DragCompleted="ColumnSplitter_DragCompleted" AutomationProperties.Name="Resize Name column" />
                            <Button Grid.Column="2" Tag="Modified" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Date modified" /><TextBlock x:Name="ModifiedSortIndicator" /></StackPanel>
                            </Button>
                            <primitives:Thumb Grid.Column="3" Tag="Modified" Style="{StaticResource ColumnResizeThumbStyle}" DragDelta="ColumnSplitter_DragDelta" DragCompleted="ColumnSplitter_DragCompleted" AutomationProperties.Name="Resize Date modified column" />
                            <Button Grid.Column="4" Tag="Type" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Type" /><TextBlock x:Name="TypeSortIndicator" /></StackPanel>
                            </Button>
                            <primitives:Thumb Grid.Column="5" Tag="Type" Style="{StaticResource ColumnResizeThumbStyle}" DragDelta="ColumnSplitter_DragDelta" DragCompleted="ColumnSplitter_DragCompleted" AutomationProperties.Name="Resize Type column" />
                            <Button Grid.Column="6" Tag="LogicalBytes" Style="{StaticResource ColumnHeaderButtonStyle}" Click="ColumnHeader_Click">
                                <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Size" /><TextBlock x:Name="SizeSortIndicator" /></StackPanel>
                            </Button>
                            <primitives:Thumb Grid.Column="7" Tag="Size" Style="{StaticResource ColumnResizeThumbStyle}" DragDelta="ColumnSplitter_DragDelta" DragCompleted="ColumnSplitter_DragCompleted" AutomationProperties.Name="Resize Size column" />
                        </Grid>
                    </Border>

                    <ListView x:Name="PrimaryFileList"
                              Grid.Row="1"
                              ItemContainerTransitions="{x:Null}"
                              Transitions="{x:Null}"
                              ItemContainerStyleSelector="{StaticResource FileRowStyleSelector}"
                              ItemTemplate="{StaticResource DetailsFileItemTemplate}"
                              IsItemClickEnabled="True"
                              CanDragItems="True"
                              AllowDrop="True"
                              IsSwipeEnabled="False"
                              DragOver="FileList_DragOver"
                              DragLeave="FileList_DragLeave"
                              Drop="FileList_Drop"
                              DragItemsStarting="FileList_DragItemsStarting"
                              DragItemsCompleted="FileList_DragItemsCompleted"
                              DoubleTapped="FileList_DoubleTapped"
                              RightTapped="FileList_RightTapped"
                              SelectionChanged="FileList_SelectionChanged"
                              ContainerContentChanging="FileList_ContainerContentChanging"
                              SelectionMode="Extended"
                              KeyDown="FileList_KeyDown">
                        <ListView.ContextFlyout>
                            <MenuFlyout x:Name="FileContextFlyout" Opening="FileContextMenu_Opening">
                                <MenuFlyoutItem x:Name="OpenMenuItem" Text="Open" Click="OpenSelected_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSubItem x:Name="OpenWithMenu" Text="Open with">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8D7;" /></MenuFlyoutSubItem.Icon>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem x:Name="OpenNewTabMenuItem" Text="Open in new tab" Click="OpenSelectedNewTab_Click">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="CopyMenuItem" Text="Copy" Click="Copy_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CutMenuItem" Text="Cut" Click="Cut_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="DuplicateMenuItem" Text="Duplicate" Click="Duplicate_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF0E3;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="RenameMenuItem" Text="Rename" Click="Rename_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="PinSidebarMenuItem" Text="Pin to sidebar" Click="PinSidebar_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE718;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutSubItem x:Name="CompressToMenu" Text="Compress to">
                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xF012;" /></MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem x:Name="CompressZipMenuItem" Text="ZIP file" Click="CompressZip_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xF012;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                </MenuFlyoutSubItem>
                                <MenuFlyoutItem x:Name="PropertiesMenuItem" Text="Properties" Click="Properties_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="DeleteMenuItem" Text="Delete" Click="Delete_Click"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                    </ListView>

                    <StackPanel x:Name="EmptyFolderPanel"
                                Grid.Row="1"
                                Canvas.ZIndex="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Spacing="8">
                        <FontIcon HorizontalAlignment="Center"
                                  FontSize="34"
                                  Glyph="&#xE8B7;"
                                  Foreground="{ThemeResource AnzFolderBrush}"
                                  Opacity="0.8" />
                        <TextBlock x:Name="EmptyFolderMessage"
                                   FontSize="14"
                                   Opacity="0.72"
                                   Text="This folder is empty." />
                    </StackPanel>

                    <Canvas IsHitTestVisible="False">
                        <Border x:Name="SelectionMarquee"
                                Visibility="Collapsed"
                                Background="#333C9BF2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1" />
                    </Canvas>
                </Grid>

                <Border Grid.Row="3"
                        Padding="10,0"
                        Background="{ThemeResource AnzPaneBackgroundBrush}"
                        BorderBrush="{ThemeResource AnzBorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11" Text="Ready" />
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
